# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Python
__pycache__/
*.py[cod]
venv/
ai_module/venv/

# Editor
.vscode/

# logs
*.log

# ai_module: dataset y checkpoints de señas dinámicas (binarios locales, no van a git)
ai_module/data/raw_videos/*
!ai_module/data/raw_videos/.gitkeep
ai_module/data/processed_landmarks/*
!ai_module/data/processed_landmarks/.gitkeep
ai_module/data/models/*
!ai_module/data/models/.gitkeep
# El modelo dinámico en uso sí va (1,2 MB): lo necesita el servidor desplegado.
!ai_module/data/models/dinamico_tcn.pt
# Fotos de Kaggle (91 MB, licencia no declarada): se bajan con
# `python data/download_datasets.py --dataset lsch-kaggle`; sus landmarks sí van.
ai_module/data/raw/lsch_kaggle/
# Manifiesto, señantes y resultados: contienen nombres de videos (datos de personas).
# Las evidencias agregadas para la tesis se copian a docs/tesis/resultados_ia/.
ai_module/data/manifest.csv
ai_module/data/signers.csv
ai_module/data/signers_template.csv
ai_module/results/
# Entorno virtual: sus .py marcarían cada corrida como -dirty en commit.txt
ai_module/.venv/
.expo-export-check/
# ai_module: respaldos automáticos del modelo dinámico exportado
ai_module/models_saved/historial/
