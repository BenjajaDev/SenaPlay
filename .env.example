# Copia este archivo como .env y completa los valores. .env no se versiona.
# Solo van valores PÚBLICOS (EXPO_PUBLIC_* termina dentro de la app).

# Servidor de IA (ai_module/server.py): IP LAN del PC o URL de un túnel.
EXPO_PUBLIC_AI_SERVER_URL=http://192.168.1.X:8000

# Opcionales: si no se definen, src/core/config/env.js usa los del proyecto actual.
# EXPO_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
